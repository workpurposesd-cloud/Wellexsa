rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return false;
    }

    function crmAccessPath() {
      return /databases/$(database)/documents/crmAccess/$(request.auth.uid);
    }

    function isActiveCrmUser() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(crmAccessPath())
        && get(crmAccessPath()).data.active == true
        && get(crmAccessPath()).data.role in ['owner', 'staff']
        && get(crmAccessPath()).data.minimumAuthTime is int
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time >= get(crmAccessPath()).data.minimumAuthTime;
    }

    function isCrmOwner() {
      return isActiveCrmUser() && get(crmAccessPath()).data.role == 'owner';
    }

    function hasCrmPermission(permission) {
      return isCrmOwner()
        || (isActiveCrmUser()
          && get(crmAccessPath()).data.role == 'staff'
          && get(crmAccessPath()).data.permissions is list
          && permission in get(crmAccessPath()).data.permissions);
    }

    function validBike(data) {
      return data.keys().hasOnly([
          'name', 'price', 'model', 'brand', 'shortDescription', 'description',
          'batteryChemistry', 'range', 'batteryWarranty', 'motor', 'topSpeed',
          'batteryLife', 'chargingTime', 'loadCapacity', 'groundClearance',
          'wheelbase', 'paintFinish', 'keylessEntry', 'antiTheft', 'gpsTracking',
          'appConnectivity', 'ipRating', 'specifications', 'imageUrls', 'imagePaths',
          'stockQuantity', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'name', 'price', 'batteryChemistry', 'range', 'batteryWarranty',
          'motor', 'topSpeed', 'imageUrls', 'imagePaths', 'stockQuantity', 'status', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.price is int && data.price > 0
        && data.batteryChemistry is string && data.batteryChemistry.size() > 0
        && data.range is string && data.range.size() > 0
        && data.batteryWarranty is string && data.batteryWarranty.size() > 0
        && data.motor is string && data.motor.size() > 0
        && data.topSpeed is string && data.topSpeed.size() > 0
        && data.imageUrls is list && data.imageUrls.size() > 0 && data.imageUrls.size() <= 8
        && data.imagePaths is list && data.imagePaths.size() == data.imageUrls.size()
        && data.stockQuantity is int && data.stockQuantity >= 0 && data.stockQuantity <= 100000
        && data.status in ['published', 'draft', 'archived']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('specifications' in data) || data.specifications is map);
    }

    function validHomepageSlide(data) {
      return data.keys().hasOnly([
          'title', 'description', 'buttonText', 'buttonUrl', 'imageUrl', 'imagePath',
          'order', 'enabled', 'active', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'title', 'description', 'buttonText', 'buttonUrl', 'imageUrl', 'imagePath',
          'order', 'enabled', 'active', 'status', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 500
        && data.buttonText is string && data.buttonText.size() <= 60
        && data.buttonUrl is string && data.buttonUrl.size() > 0 && data.buttonUrl.size() <= 500
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2048
        && data.imagePath is string && data.imagePath.matches('homepage-slides/[A-Za-z0-9_-]+/[A-Za-z0-9._-]+')
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.enabled is bool && data.active is bool
        && data.status in ['published', 'draft']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /bikes/{bikeId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin() && validBike(request.resource.data);
      allow update: if isAdmin() && validBike(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /homepageSlides/{slideId} {
      allow read: if isAdmin() || (resource.data.status == 'published' && resource.data.enabled == true);
      allow create: if isAdmin() && validHomepageSlide(request.resource.data);
      allow update: if isAdmin() && validHomepageSlide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /adminUsernames/{username} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'mobile', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'mobile', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.mobile is string
        && request.resource.data.createdAt is timestamp;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'mobile'])
        && request.resource.data.name is string
        && request.resource.data.mobile is string;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || hasCrmPermission('orders:view')
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /paymentIssues/{issueId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /checkoutRequests/{requestId} {
      allow read, write: if false;
    }

    match /crmAccess/{uid} {
      allow read, write: if false;
    }

    match /crmCustomers/{customerId} {
      allow get, list: if hasCrmPermission('customers:view');
      allow create, update, delete: if false;

      match /contactHistory/{eventId} {
        allow get, list: if hasCrmPermission('customers:view');
        allow create, update, delete: if false;
      }
    }

    match /crmEnquiries/{enquiryId} {
      allow get, list: if hasCrmPermission('customers:view');
      allow create, update, delete: if false;
    }

    match /crmLeadIntakes/{intakeId} {
      allow get, list: if hasCrmPermission('customers:view') || hasCrmPermission('leads:resolve');
      allow create, update, delete: if false;
    }

    match /crmPurchases/{purchaseId} {
      allow get, list: if hasCrmPermission('purchases:view');
      allow create, update, delete: if false;
    }

    match /crmAuditEvents/{eventId} {
      allow get, list: if isCrmOwner();
      allow create, update, delete: if false;
    }

    match /crmPhoneIndex/{phoneHash} {
      allow read, write: if false;
    }

    match /crmWebUserIndex/{uid} {
      allow read, write: if false;
    }

    match /crmPurchaseRequests/{requestId} {
      allow read, write: if false;
    }
  }
}
