NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
FIREBASE_PROJECT_ID=your-firebase-project-id
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=wellexsa
MYSQL_USER=wellexsa_app
MYSQL_PASSWORD=replace-with-local-secret
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT=10000
PHONE_ENCRYPTION_ACTIVE_VERSION=1
PHONE_ENCRYPTION_KEYS_JSON={"1":"replace-with-base64-encoded-32-byte-key"}
PHONE_LOOKUP_ACTIVE_VERSION=1
PHONE_LOOKUP_KEYS_JSON={"1":"replace-with-a-different-base64-encoded-32-byte-key"}
